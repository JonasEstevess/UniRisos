rules_version = '2';

// Regras de segurança do Firestore da Uni Risos.
// Publique em: console do Firebase > Firestore Database > Regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Perfil do paciente: só o próprio paciente e a clínica leem.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Quem é da clínica. Criado manualmente no console; ninguém escreve pelo site.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Horários ocupados: só data e hora, sem dados pessoais, para o site mostrar a disponibilidade.
    // Não existe regra de update: tentar gravar um horário que já existe é recusado.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && slotId == request.resource.data.date + '_' + request.resource.data.time.replace(':', '');
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Consultas: o paciente vê e cancela as suas; a clínica vê e altera todas.
    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.date + '_' + request.resource.data.time.replace(':', '')));
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelado');
    }
  }
}
